{
  "version": 2,
  "buildCommand": "bash scripts/vercel-build.sh",
  "outputDirectory": "dist/InternLink/browser",
  "installCommand": "npm ci",
  "routes": [
    { "src": "/assets/(.*)", "dest": "/assets/$1" },
    { "src": "/(.*\\.(?:js|css|ico|png|jpg|jpeg|gif|svg|woff|woff2|ttf|eot|json|map))", "dest": "/$1" },
    { "src": "/(.*)", "dest": "/index.html", "status": 200 }
  ]
}
